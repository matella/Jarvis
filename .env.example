# Copy to .env and fill in. .env is gitignored; this template is committed.

# --- Remote homelab access -------------------------------------------------
# SSH target for the Ubuntu/Docker host (used by `make context` and `make tunnel`).
REMOTE_SSH=user@homelab.lan

# --- Container daemon ------------------------------------------------------
# Loopback on the REMOTE host that published ports bind to (kept off the LAN).
BIND_HOST=127.0.0.1

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis
# Host/port as seen FROM the Mac: 127.0.0.1 reached through the SSH tunnel.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --- Jarvis ----------------------------------------------------------------
# Global operational mode. Defaults to observe (propose-only) per Hard Rule 6.
JARVIS_MODE=observe

# Security (5.5c). Egress allowlist for connectors/search/capture — DEFAULT-DENY.
# Comma-separated (or JSON) bare hosts; subdomains are matched. Empty = block all outbound.
# EGRESS_ALLOWLIST=searx.lan,api.openweathermap.org

# Conversational gateway (6a). Local homelab only — do NOT expose. Empty token = open dev mode.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
# GATEWAY_TOKEN=change-me-to-require-auth
GATEWAY_ACTOR=local

# --- Containerized deploy (docker compose --profile app, built on the box) -----------------
# All have working defaults; only set these to override. The gateway/daemon containers set
# POSTGRES_HOST=postgres / REDIS_HOST=redis / OLLAMA_HOST=host.docker.internal / DOCKER_CONTEXT=default
# themselves in docker-compose.yml — you don't set those here.
# CONSOLE_PORT=8092            # host port the console (interface) publishes
# CONSOLE_BIND=0.0.0.0         # 0.0.0.0 = LAN (front with nginx-proxy-manager/VPN); 127.0.0.1 = loopback

# Connectors (8). Enable read-ingest workers; hosts must be egress-allowlisted. Secrets below.
# CONNECTORS_ENABLED=feeds,mail
# FEED_URLS=https://news.example.com/rss,https://blog.example.org/atom.xml
# IMAP_HOST=imap.example.com
# SMTP_HOST=smtp.example.com
# MAIL_USERNAME / MAIL_PASSWORD  → secrets (env/vault), never logged or prompted
# HA_BASE_URL=http://homeassistant.lan:8123      # HA_TOKEN via secrets
# Inbound webhooks: per-source HMAC secret, e.g. WEBHOOK_SECRET_GITHUB, WEBHOOK_SECRET_GRAFANA

# Search + capture (9). In the containerized deploy this is ON by default: `make deploy` starts
# SearXNG (search profile) and the gateway/daemon default to SEARXNG_URL=http://searxng:8080 with
# EGRESS_ALLOWLIST=searxng. Override below only to point elsewhere or to turn search off (unset URL).
# Note: SearXNG's JSON format must be enabled in its settings.yml (search.formats: [html, json]).
# SEARXNG_URL=http://searxng:8080
# Capture needs Playwright browsers: `playwright install chromium`.

# Models. Reasoning defaults to qwen3:1.7b (lightest tenant on the shared 8 GB GPU). Override per
# role (the model must be `ollama pull`-ed on the host). qwen3:4b / qwen3:8b = more capable/heavier.
# MODEL_REASONING=qwen3:4b

# Voice (10). STT is faster-whisper in-process (local, on the box) — WHISPER_MODEL is a
# faster-whisper name (base.en / base / small), "" disables. TTS is in-browser by default;
# set PIPER_VOICE for server-side Piper instead.
# WHISPER_MODEL=base.en   WHISPER_DEVICE=cpu   WHISPER_COMPUTE=int8
# PIPER_VOICE=/voices/en_US-amy-medium.onnx
# WAKE_WORD_ENABLED=false
