# Copy to .env and fill in. .env is gitignored; this template is committed.

# --- Remote homelab access -------------------------------------------------
# SSH target for the Ubuntu/Docker host (used by `make context` and `make tunnel`).
REMOTE_SSH=user@homelab.lan

# --- Container daemon ------------------------------------------------------
# Loopback on the REMOTE host that published ports bind to (kept off the LAN).
BIND_HOST=127.0.0.1

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis
# Host/port as seen FROM the Mac: 127.0.0.1 reached through the SSH tunnel.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --- Jarvis ----------------------------------------------------------------
# Global operational mode. Defaults to observe (propose-only) per Hard Rule 6.
JARVIS_MODE=observe

# Security (5.5c). Egress allowlist for connectors/search/capture — DEFAULT-DENY.
# Comma-separated (or JSON) bare hosts; subdomains are matched. Empty = block all outbound.
# EGRESS_ALLOWLIST=searx.lan,api.openweathermap.org

# Conversational gateway (6a). Local homelab only — do NOT expose. Empty token = open dev mode.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
# GATEWAY_TOKEN=change-me-to-require-auth
GATEWAY_ACTOR=local

# --- Containerized deploy (docker compose --profile app, built on the box) -----------------
# All have working defaults; only set these to override. The gateway/daemon containers set
# POSTGRES_HOST=postgres / REDIS_HOST=redis / OLLAMA_HOST=host.docker.internal / DOCKER_CONTEXT=default
# themselves in docker-compose.yml — you don't set those here.
# CONSOLE_PORT=8092            # host port the console (interface) publishes
# CONSOLE_BIND=0.0.0.0         # 0.0.0.0 = LAN (front with nginx-proxy-manager/VPN); 127.0.0.1 = loopback
# NTFY_PORT=8093               # host port the ntfy server publishes (front with NPM, like the console)
# NTFY_BIND=0.0.0.0

# Push notifications (ntfy). `make deploy` runs a self-hosted ntfy; the gateway/daemon publish to
# it internally (NTFY_URL=http://ntfy:80). To RECEIVE on your devices:
#   1) Add an NPM proxy host for ntfy (→ jarvis-ntfy:80 or the box:NTFY_PORT) on an https domain,
#      reachable over your VPN; set NTFY_BASE_URL to that https URL.
#   2) Pick an unguessable topic and set NTFY_TOPIC (this is the only thing gating who can read).
#   3) Install the ntfy app (Android/desktop/web), point it at your base URL, subscribe to the topic.
#      For a self-hosted server, enable "instant delivery" in the app (Firebase is ntfy.sh-only).
# NTFY_BASE_URL=https://ntfy.yourdomain.tld
# NTFY_TOPIC=jarvis-home-7f3a9c
# NOTIFY_WEBHOOK_URL=          # optional extra channel: generic JSON POST (Discord/Slack/Gotify)

# Native mobile app (Capacitor) — the app calls the gateway cross-origin, so its origin must be
# CORS-allowed. Defaults already cover the capacitor/localhost origins; add your console's https
# domain here if you serve the web console from a different origin. See docs/MOBILE.md.
# GATEWAY_CORS_ORIGINS=capacitor://localhost,https://localhost,https://jarvis.yourdomain.tld

# Connectors (8). Enable read-ingest workers; feed/mail hosts MUST be egress-allowlisted. Add the
# feed hosts to EGRESS_ALLOWLIST above (comma-separated), e.g.
#   EGRESS_ALLOWLIST=searxng,ntfy,www.brusselstimes.com,www.politico.eu,www.euractiv.com,...
# CONNECTORS_ENABLED=feeds,mail
# A curated starter set (Belgium / EU / tech / AI) — verify exact URLs at add-time:
# FEED_URLS=https://www.brusselstimes.com/feed,https://www.politico.eu/feed,https://www.euractiv.com/feed,https://news.ycombinator.com/rss,https://simonwillison.net/atom/everything
#
# Inbox triage (everyday-AI): summarize + classify inbound mail/feed items, push only the important
# ones to ntfy (the rest stay on the spine for a digest). One inference per item.
# TRIAGE_ENABLED=true
# TRIAGE_MIN_IMPORTANCE=high       # high (quietest) | normal | low (everything)
#
# Mail. Single account via IMAP_HOST + MAIL_USERNAME/MAIL_PASSWORD secrets (use an APP PASSWORD):
# IMAP_HOST=imap.gmail.com
# SMTP_HOST=smtp.gmail.com
# MAIL_USERNAME / MAIL_PASSWORD  → secrets (env/vault), never logged or prompted
# MULTIPLE accounts: JSON list; *_secret are SecretsProvider KEY NAMES (set those keys as secrets):
# MAIL_ACCOUNTS=[{"label":"gmail","imap_host":"imap.gmail.com","user_secret":"GMAIL_USER","pass_secret":"GMAIL_PASS"},{"label":"work","imap_host":"imap.fastmail.com","user_secret":"WORK_USER","pass_secret":"WORK_PASS"}]
# Home Assistant (read + act). Token: HA_TOKEN secret; host must be egress-allowlisted.
# Add "homeassistant" to CONNECTORS_ENABLED to poll watched entities → ha.state_changed events.
# HA_BASE_URL=http://homeassistant.lan:8123
# HA_WATCH_ENTITIES=binary_sensor.front_door,climate.living,light.office
# HA_POLL_INTERVAL_S=60
#
# Calendar (read-only). Add "calendar" to CONNECTORS_ENABLED; ICS host(s) must be allowlisted.
# CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/<secret>/basic.ics
# CALENDAR_HORIZON_H=24
#
# Reminders are always-on (no config): "remind me to … in 10m / tomorrow at 9" in chat, or the CLI
# `jarvis remind add "call dentist" --in 2h` / `--at 2026-05-31T09:00:00Z`. Fired via the notifier.
#
# Inbound webhooks → events on the spine. POST to  https://<your-jarvis-domain>/inbound/<source>
#   - HMAC sources (GitHub/Grafana): WEBHOOK_SECRET_<SOURCE>  (e.g. WEBHOOK_SECRET_GITHUB)
#   - Token sources (Radarr/Sonarr/Jellyseerr — they can't HMAC-sign): set WEBHOOK_TOKEN_<SOURCE>
#     as a secret, then in the app's webhook connection add a header  X-Jarvis-Token: <that value>
#     (Jellyseerr: use its Authorization-header field). Maps to radarr.grab / sonarr.download /
#     jellyseerr.media_pending / … so Jarvis is aware of your media stack (queryable + reactable).
# WEBHOOK_TOKEN_RADARR / WEBHOOK_TOKEN_SONARR / WEBHOOK_TOKEN_JELLYSEERR  → secrets
#
# *arr / Jellyseerr ACTIONS (approve a request, trigger a search) are gated capability plugins —
# see docs/examples/plugins/*.yaml; copy into PLUGINS_DIR, fill host + API key, allowlist the host.
#
# qBittorrent (read-only download status). Add "qbittorrent" to CONNECTORS_ENABLED. Behind gluetun,
# so its localhost-bypass doesn't apply — give WebUI creds as secrets. `jarvis torrents` /
# GET /api/torrents show live activity + ETA; a torrent.completed event hits the spine on finish.
# QBITTORRENT_URL=http://host.docker.internal:8088
# QBITTORRENT_USER / QBITTORRENT_PASS  → secrets (env/vault), never logged

# Search + capture (9). In the containerized deploy this is ON by default: `make deploy` starts
# SearXNG (search profile) and the gateway/daemon default to SEARXNG_URL=http://searxng:8080 with
# EGRESS_ALLOWLIST=searxng. Override below only to point elsewhere or to turn search off (unset URL).
# Note: SearXNG's JSON format must be enabled in its settings.yml (search.formats: [html, json]).
# SEARXNG_URL=http://searxng:8080
# Capture needs Playwright browsers: `playwright install chromium`.

# Models. Reasoning defaults to qwen3:1.7b (lightest tenant on the shared 8 GB GPU). Override per
# role (the model must be `ollama pull`-ed on the host). qwen3:4b / qwen3:8b = more capable/heavier.
# MODEL_REASONING=qwen3:4b

# Voice (10). STT is faster-whisper in-process (local, on the box) — WHISPER_MODEL is a
# faster-whisper name (base.en / base / small), "" disables. TTS is in-browser by default;
# set PIPER_VOICE for server-side Piper instead.
# WHISPER_MODEL=base.en   WHISPER_DEVICE=cpu   WHISPER_COMPUTE=int8
# PIPER_VOICE=/voices/en_US-amy-medium.onnx
# WAKE_WORD_ENABLED=false
